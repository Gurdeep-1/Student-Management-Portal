# Copy this file to `portal.env` (or `.env`) and fill in real values.
# NEVER commit the filled-in file — portal.env and .env are gitignored.

# Required. Use a long, random, unpredictable string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required in production. Comma-separated list of allowed frontend origins.
# Example: https://portal.yourcollege.edu,https://admin.yourcollege.edu
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Defaults to 3001.
PORT=3001

# Optional. Set to "production" to enable production hardening
# (e.g. refuses to start without JWT_SECRET).
NODE_ENV=development

# Optional. Set to "1" only if this server sits behind a reverse proxy /
# load balancer that sets X-Forwarded-For correctly (nginx, Render, Fly,
# etc.). Needed for the login rate limiter to see real client IPs instead
# of the proxy's IP. Do NOT set this if the server is directly internet-facing.
TRUST_PROXY=

# Optional. Postgres is used automatically when this is set; otherwise the
# app uses SQLite. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# The database itself must already exist — the app creates tables inside it.
DATABASE_URL=

# Optional. Set to "true" if your Postgres provider requires SSL
# (most managed/cloud providers do, e.g. Heroku, Render, Supabase).
PGSSL=
